# ── MMMuzik V2 environment ──────────────────────────────────────────────────
# Copy to `.env` for local (non-Docker) development:  cp .env.example .env
# Docker Compose sets these for the container automatically (see compose files).
# RULE: configuration is read at RUNTIME — nothing here is baked into the build.

# development | production | test
NODE_ENV=development

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://mmmuzik:mmmuzik@localhost:5432/mmmuzik

# Redis connection string (cache, locks, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Public origin of the app (single origin for UI + API + realtime)
APP_URL=http://localhost:3000

# Port the custom server listens on (required by src/server/index.ts)
PORT=3000
