# ── MMMuzik V2 — PRODUCTION environment (containerized deploy) ────────────────
# Copy to `.env.production` on the VPS and fill in real values:
#     cp .env.production.example .env.production
# Then keep it SECRET — `.env.production` is gitignored and must never be committed.
#
# Used by:  docker compose --env-file .env.production -f docker-compose.prod.yml ...

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# MUST be the exact public origin. Drives Socket.IO CORS + Secure cookies.
# `www` is 301-redirected to this canonical host by nginx.
APP_URL=https://muzikskul.xyz

# Port the app listens on INSIDE the container (nginx proxies to app:3000).
PORT=3000

# YouTube Data API key (server-side ONLY — in-app search + add-time guards).
# Leave EMPTY to disable search (falls back to URL-paste). Keep SECRET.
# Google Cloud Console → enable "YouTube Data API v3" → API key. Request a quota
# increase before launch (default ~10k units/day ≈ 100 searches/day).
YOUTUBE_API_KEY=CHANGE_ME_youtube_data_api_key

# ── PostgreSQL (internal container `postgres`, never exposed publicly) ─────────
POSTGRES_USER=mmmuzik
# CHANGE THIS — generate a strong password, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=mmmuzik

# Prisma connection string. Host is the compose service name `postgres`.
# Keep USER/PASSWORD/DB in sync with the three POSTGRES_* values above.
DATABASE_URL=postgresql://mmmuzik:CHANGE_ME_strong_db_password@postgres:5432/mmmuzik

# ── Redis (internal container `redis`, never exposed publicly) ─────────────────
REDIS_URL=redis://redis:6379

# ── Let's Encrypt (used by deploy/init-letsencrypt.sh) ─────────────────────────
DOMAIN=muzikskul.xyz
CERTBOT_EMAIL=you@example.com
# Set STAGING=1 to use Let's Encrypt's staging CA while testing (avoids rate
# limits; issues an untrusted cert). Set to 0 (or remove) for real certs.
STAGING=0
